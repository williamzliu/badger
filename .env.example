PORT=3000
DATABASE_PATH=./data/badger.db
PUBLIC_URL=http://localhost:3000

# Cartesia Line (local outbound-call client and webhook handling)
CARTESIA_API_KEY=
CARTESIA_AGENT_ID=
CARTESIA_FROM_NUMBER_ID=
CARTESIA_WEBHOOK_SECRET=

# Cartesia-hosted agent deployment
OPENAI_API_KEY=
BADGER_LLM_MODEL=gpt-5.4
BADGER_BACKEND_URL=https://badger.example
BADGER_TOOL_SECRET=

# Photon Spectrum managed messaging
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Public HTTPS origin used by Cartesia callbacks, without a trailing slash
PUBLIC_BASE_URL=https://badger.example
