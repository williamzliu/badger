PORT=3000
DATABASE_PATH=./data/badger.db
PUBLIC_URL=http://localhost:3000
BADGER_LIVE_MODE=false
BADGER_DEMO_MODE=true
BADGER_CALL_DELAY_MS=0
BADGER_CALL_STAGGER_MS=1000

# Cartesia Line (local outbound-call client and webhook handling)
CARTESIA_API_KEY=
CARTESIA_AGENT_ID=
CARTESIA_FROM_NUMBER_ID=
CARTESIA_WEBHOOK_SECRET=
CARTESIA_REQUEST_TIMEOUT_MS=10000

# Cartesia-hosted agent deployment
OPENAI_API_KEY=
BADGER_LLM_MODEL=gpt-5.4
BADGER_BACKEND_URL=https://badger.example
BADGER_TOOL_SECRET=

# Live option research executed as a client-side tool for Sail
BADGER_RESEARCH_MODEL=gpt-5.4-mini
BADGER_RESEARCH_REASONING_EFFORT=none
BADGER_RESEARCH_TIMEOUT_MS=30000
BADGER_RESEARCH_CACHE_TTL_MS=1800000
BADGER_DEFAULT_LOCATION=San Francisco Bay Area
# Two-second conversational hot path; Sail remains the long-lived coordinator.
BADGER_FAST_INBOUND_MODEL=gpt-4.1-nano
BADGER_FAST_INBOUND_TIMEOUT_MS=2000
# Optional OpenAI-compatible endpoint override
OPENAI_BASE_URL=https://api.openai.com/v1

# Photon Spectrum managed messaging
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Required in live mode: persisted multi-turn coordinator. Backend validates every action.
SAIL_API_KEY=
SAIL_MODEL=openai/gpt-oss-120b
SAIL_REASONING_EFFORT=low
SAIL_COMPLETION_WINDOW=asap
SAIL_BASE_URL=https://api.sailresearch.com/v1
SAIL_TIMEOUT_MS=45000

# Public HTTPS origin used by Cartesia callbacks, without a trailing slash
PUBLIC_BASE_URL=https://badger.example

# Demo participant phone numbers (frontend prefill; falls back to 555 placeholders)
VITE_DEMO_PHONE_HOST=
VITE_DEMO_PHONE_SAM=
VITE_DEMO_PHONE_DANA=
VITE_DEMO_PHONE_WILLIAM=
