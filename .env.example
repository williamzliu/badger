PORT=3000
DATABASE_PATH=./data/badger.db
PUBLIC_URL=http://localhost:3000
BADGER_LIVE_MODE=false
BADGER_DEMO_MODE=true
BADGER_CALL_DELAY_MS=10000
BADGER_CALL_STAGGER_MS=1000

# Cartesia Line (local outbound-call client and webhook handling)
CARTESIA_API_KEY=
CARTESIA_AGENT_ID=
CARTESIA_FROM_NUMBER_ID=
CARTESIA_WEBHOOK_SECRET=

# Cartesia-hosted agent deployment
OPENAI_API_KEY=
BADGER_LLM_MODEL=gpt-5.4
BADGER_BACKEND_URL=https://badger.example
BADGER_TOOL_SECRET=

# Photon Spectrum managed messaging
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Required in live mode: persisted multi-turn coordinator. Backend validates every action.
SAIL_API_KEY=
SAIL_MODEL=zai-org/GLM-5.2-FP8
SAIL_BASE_URL=https://api.sailresearch.com/v1

# Public HTTPS origin used by Cartesia callbacks, without a trailing slash
PUBLIC_BASE_URL=https://badger.example

# Demo participant phone numbers (frontend prefill; falls back to 555 placeholders)
VITE_DEMO_PHONE_HOST=
VITE_DEMO_PHONE_SAM=
VITE_DEMO_PHONE_DANA=
VITE_DEMO_PHONE_WILLIAM=
